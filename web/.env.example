# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the site (used for sign-in links and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — film analysis with Claude. Without it NAS uses its built-in analyzer.
ANTHROPIC_API_KEY=

# Optional — confirmation emails to filmmakers via Resend
RESEND_API_KEY=
EMAIL_FROM=NAS <noreply@your-domain.com>
